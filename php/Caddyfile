{
    log default {
          output stdout
          level DEBUG
    }
    frankenphp
}

:8080 {
    root * public/
    encode zstd br gzip
    #php_server
	php
	file_server

	# Кэш для изображений из resize_cache
	@cachedFiles {
		path_regexp cached ^/upload/resize_cache/.+\.(?:png|jpe?g|gif|webp)$
	}
	header @cachedFiles Cache-Control "public, max-age=31536000, immutable"

	# Bitrix URL rewrite логика
	@rewrite {
		not file
		not path /bitrix/urlrewrite.php
		path_regexp clean ^/(.+)$
	}
	rewrite @rewrite /bitrix/urlrewrite.php

	# 404 → index.php
	handle_errors {
		@notfound {
			expression {http.error.status_code} == 404
		}
		rewrite @notfound /index.php
	}

	# Блокировка приватных файлов
	@blocked {
		path /bitrix/php_interface/dbconn.php
		path /bitrix/.settings.php
	}
	respond @blocked 403}
